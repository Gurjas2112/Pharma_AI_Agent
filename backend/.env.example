# ---- copy to backend/.env and fill in (never commit .env) -------------------
ENV_MODE=development
# LLM: Ollama on AWS EC2 (prod) / local GPU container (prototype) behind Caddy bearer proxy
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PROXY_TOKEN=
LLM_MODEL_PRIMARY=qwen2.5:7b-instruct
LLM_MODEL_FAST=qwen2.5:3b-instruct
EMBED_MODEL=nomic-embed-text
MOCK_API_URL=http://localhost:8081
MOCK_API_KEY=

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Session pooler (IPv4) - URL-encode special chars in the password (@ -> %40)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

FIRECRAWL_API_KEY=
REDIS_URL=redis://localhost:6379/0

# AWS - LocalStack emulator in prototype (unset AWS_ENDPOINT_URL for real AWS)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1

# Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repurpora

# Aegra
AUTH_TYPE=custom
RUN_MIGRATIONS_ON_STARTUP=true
# AUTH_DISABLED=true   # local dev only

# Optional: run without a GPU on any OpenAI-compatible endpoint (vLLM, LM Studio, Groq, Together, OpenAI)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# LLM_MODEL_PRIMARY=llama-3.3-70b-versatile
# LLM_MODEL_FAST=llama-3.1-8b-instant
# DEFAULT_REGION=India
