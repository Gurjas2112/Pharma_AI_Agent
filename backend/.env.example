# Backend Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8000
FRONTEND_URL=http://localhost:3000

# LLM Configuration
LLM_MODEL=mistral
MISTRAL_MODEL_PATH=models/mistral-7b-instruct-v0.1.Q4_K_M.gguf

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Embedding Model (uses local Mistral)
EMBEDDING_MODEL_TYPE=mistral_local

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120

# ========================
# Real Data Source API Keys
# ========================

# IQVIA Market Data
# Note: IQVIA requires enterprise API subscription for programmatic access
# Visit https://www.iqvia.com/ for commercial access options

# UN Comtrade API (for EXIM trade data)
# Get free key at: https://comtradeplus.un.org/
COMTRADE_SUBSCRIPTION_KEY=your_comtrade_key_here

# Patent APIs are generally free (USPTO, EPO)
# patent_client library doesn't require API keys for basic usage

# ClinicalTrials.gov API
# pytrials library uses the free public API - no key required

# DuckDuckGo Search
# duckduckgo-search is free and doesn't require API keys

# PDF Processing
# pdfplumber and WeasyPrint are local libraries - no API keys needed

